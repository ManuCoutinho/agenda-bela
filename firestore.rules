rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O marcador vira o UID da manicure (UID_OWNER no .env.local) quando as regras
    // são geradas: scripts/gerar-regras.mjs, que roda antes de firebase deploy --only firestore.
    function uidDaManicure() {
      return '__UID_DA_MANICURE__';
    }

    function uidService() {
      return '__UID_SERVICE__';
    }


    function isOwner() {
      return request.auth != null && request.auth.uid == uidDaManicure() || request.auth.uid == uidService();
    }

    match /config/{doc} {
      allow read: if doc == 'publico' || isOwner();
      allow write: if isOwner();
    }
    match /clientes/{id}      { allow read, write: if isOwner(); }
    match /agendamentos/{id}  { allow read, write: if isOwner(); }
    match /bloqueios/{id}     { allow read, write: if isOwner(); }

    match /pedidos/{id} {
      // a trava listada no pedido precisa existir ao fim do mesmo lote: pendente (pedido
      // antigo, por até 24 h) ou definitiva e deste pedido (I08: confirmação automática)
      function travaDoPedido(travaId) {
        let t = getAfter(/databases/$(database)/documents/travas/$(travaId));
        return t != null && (
          (request.resource.data.status == 'pendente'
            && t.data.expiraEm != null && t.data.expiraEm > request.time)
          || (request.resource.data.status == 'confirmado'
            && t.data.expiraEm == null && t.data.get('pedidoId', '') == id));
      }
      function travaNaPosicao(travas, i) {
        return travas.size() <= i || travaDoPedido(travas[i]);
      }

      // RF14: com a página pausada, ninguém cria pedido
      function paginaAberta() {
        let publico = /databases/$(database)/documents/config/publico;
        return !exists(publico) || get(publico).data.get('pausa', {}).get('ativa', false) != true;
      }

      // I06: só nos meses abertos pela manicure (AAAAMM no horário de Brasília, UTC-3 fixo
      // desde 2019). Sem o campo, vale só o limite de 92 dias abaixo.
      function mesAberto(inicio) {
        let publico = /databases/$(database)/documents/config/publico;
        let local = inicio - duration.value(3, 'h');
        return !exists(publico)
          || !('mesesAbertos' in get(publico).data)
          || (local.year() * 100 + local.month()) in get(publico).data.mesesAbertos;
      }

      allow read, update, delete: if isOwner();
      allow create: if paginaAberta()
        && mesAberto(request.resource.data.inicio)
        && request.resource.data.keys().hasOnly(
          ['nome', 'whatsapp', 'servicoId', 'inicio', 'consentimento', 'status', 'criadoEm', 'travas'])
        && request.resource.data.keys().hasAll(
          ['nome', 'whatsapp', 'servicoId', 'inicio', 'consentimento', 'status', 'criadoEm', 'travas'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9]{12,13}$')
        && request.resource.data.servicoId is string
        && request.resource.data.consentimento == true
        && request.resource.data.status in ['pendente', 'confirmado']
        && request.resource.data.criadoEm == request.time
        // RN03 no servidor: nada no passado nem além da maior janela (90 dias)
        && request.resource.data.inicio is timestamp
        && request.resource.data.inicio > request.time
        && request.resource.data.inicio < request.time + duration.value(92, 'd')
        // até 12 travas (pedidos antigos de meia hora), todas no mesmo lote
        && request.resource.data.travas is list
        && request.resource.data.travas.size() >= 1
        && request.resource.data.travas.size() <= 12
        && travaNaPosicao(request.resource.data.travas, 0)
        && travaNaPosicao(request.resource.data.travas, 1)
        && travaNaPosicao(request.resource.data.travas, 2)
        && travaNaPosicao(request.resource.data.travas, 3)
        && travaNaPosicao(request.resource.data.travas, 4)
        && travaNaPosicao(request.resource.data.travas, 5)
        && travaNaPosicao(request.resource.data.travas, 6)
        && travaNaPosicao(request.resource.data.travas, 7)
        && travaNaPosicao(request.resource.data.travas, 8)
        && travaNaPosicao(request.resource.data.travas, 9)
        && travaNaPosicao(request.resource.data.travas, 10)
        && travaNaPosicao(request.resource.data.travas, 11);
    }

    match /travas/{id} {
      // I08: trava definitiva só junto com o pedido confirmado que a lista, criado no mesmo
      // lote (um pedido antigo não serve para prender de novo um horário cancelado)
      function pedidoNovoConfirmado(pedidoId) {
        let caminho = /databases/$(database)/documents/pedidos/$(pedidoId);
        let p = getAfter(caminho);
        return !exists(caminho) && p != null
          && p.data.status == 'confirmado' && id in p.data.travas;
      }
      function travaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'hora', 'expiraEm', 'pedidoId'])
          && d.data is string
          && d.hora is string
          && id == d.data + '_' + d.hora
          && (
            (d.expiraEm is timestamp
              && !('pedidoId' in d)
              && d.expiraEm > request.time
              && d.expiraEm <= request.time + duration.value(24, 'h'))
            || (d.expiraEm == null && d.pedidoId is string && pedidoNovoConfirmado(d.pedidoId)));
      }
      allow read: if true;
      allow create: if isOwner() || travaValida();
      // a cliente só sobrescreve uma trava que já expirou
      allow update: if isOwner()
        || (resource.data.expiraEm != null
            && resource.data.expiraEm < request.time
            && travaValida());
      allow delete: if isOwner();
    }
  }
}
